{
  "name": "war3-model",
  "version": "4.0.1-wam.4",
  "description": "Warcraft 3 model parser, generator, convertor and previewer",
  "keywords": [
    "warcraft3",
    "reforged",
    "mdl",
    "mdx",
    "blp",
    "webgl",
    "webgpu",
    "typescript",
    "front-end",
    "backend"
  ],
  "homepage": "https://github.com/AzurCrystal/war3-model",
  "bugs": {
    "url": "https://github.com/AzurCrystal/war3-model/issues"
  },
  "repository": "github:AzurCrystal/war3-model",
  "author": "4eb0da",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "benchmark-blp": "node scripts/benchmark-blp-wasm.mjs",
    "build-blp-wasm": "node scripts/build-blp-wasm.mjs",
    "check-blp-wasm": "node scripts/build-blp-wasm.mjs --check",
    "prepublishOnly": "npm run check",
    "prepare": "npm run build-lib",
    "dev": "vite",
    "build-lib": "vite build",
    "build-samples": "SAMPLES=1 vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run check-blp-wasm && npm run typecheck && npm run test && npm run build-lib",
    "lint": "eslint --ext .ts ."
  },
  "dependencies": {
    "gl-matrix": "3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/eslint": "9.6.1",
    "@types/estree": "1.0.8",
    "@types/node": "25.5.0",
    "@webgpu/types": "0.1.69",
    "dds-parser": "1.0.1",
    "eslint": "10.0.3",
    "husky": "7.0.4",
    "monaco-editor": "0.55.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "8.0.0",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.1.10"
  },
  "files": [
    "dist/*",
    "licenses/*",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "dist/war3-model.cjs",
  "module": "dist/es/war3-model.mjs",
  "typings": "dist/war3-model.d.ts",
  "exports": {
    ".": {
      "types": "./dist/war3-model.d.ts",
      "require": "./dist/war3-model.cjs",
      "import": "./dist/es/war3-model.mjs"
    },
    "./dist/": "./dist/"
  },
  "type": "module"
}
